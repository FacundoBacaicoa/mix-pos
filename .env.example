# Cuenta del dueño
# Si las dejás vacías, en desarrollo se usa el usuario dueno y la contraseña semilla-dev.
ADMIN_USERNAME=dueno
ADMIN_PASSWORD=
# En producción tiene que tener al menos 16 caracteres.
SESSION_SECRET=

# Carpeta de la base y las fotos. Si está vacía, se usa la carpeta temporal del sistema.
# No la pongas dentro del proyecto: Next reinicia el servidor cuando cambian archivos de acá.
SEMILLA_DATA_DIR=
